{
  "appId": "com.idekan.ffll",
  "appName": "FFLL",
  "webDir": "src",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#31d53d",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#999999",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}